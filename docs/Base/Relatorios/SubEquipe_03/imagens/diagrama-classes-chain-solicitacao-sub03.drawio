<mxfile host="app.diagrams.net" agent="SubEquipe_03" version="24.0.0"><diagram id="CoR_Classes" name="Chain of Responsibility - Classes"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tit" value="Chain of Responsibility — Alteração de Categoria da CNH (Diagrama de Classes)" style="text;html=1;fontSize=15;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1100" height="28" as="geometry"/></mxCell><mxCell id="S" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;SolicitacaoAlteracaoCategoria&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;- categoria_desejada: str&lt;/p&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;- status: str&lt;/p&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;- motivo: str&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ validar_elegibilidade(primeiro_validador): str&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="290" height="150" as="geometry"/></mxCell><mxCell id="H" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Habilitacao&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;- categoria: str&lt;/p&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;- bloqueios_ativos: list&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ possui_bloqueio_ativo(): bool&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;html=1;whiteSpace=wrap;fillColor=#f5f5f